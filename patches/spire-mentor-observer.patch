+            screen.AdviceFor,
+            screen.SignatureOrDefault,
+            Floor = screen.State.GetValueOrDefault("floor"),
+            CanSkip = screen.State.GetValueOrDefault("can_skip"),
+            Options = options.Select(option => keys.Select(key => option.GetValueOrDefault(key)).ToArray())
+        });

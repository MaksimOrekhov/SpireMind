+    private void ConfirmObserver(SimScreenDecision? screen)
+    {
+        if (_observerLease is not { } lease)
+            return;
+        object? visibleScreen = null;
+        string? key = null;
+        if (SimRuntime.Mode == SimMode.Advisor && Engine.GetMainLoop() is SceneTree { Paused: false })
+        {
+            if (screen != null && screen.Screen is CanvasItem item && item.IsVisibleInTree())
+            {
+                visibleScreen = screen.Screen;
+                key = ObserverKey(screen);
+            }
+            else if (screen == null && !SimRoomNodes.MapOpen() && !SimRoomNodes.OverlayUp() &&
+                     CombatManager.Instance.IsInProgress && !CombatManager.Instance.PlayerActionsDisabled &&
+                     LocalContext.GetMe(RunManager.Instance.DebugOnlyGetState())?.PlayerCombatState?.Phase == PlayerTurnPhase.Play)
+            {
+                key = "combat_action";
+            }
+        }
+        BridgeServer bridge = BridgeServer.Instance;
+        string? frame = lease.Confirm(bridge.ClientGeneration, _positionEpoch, visibleScreen, key);
+        if (frame != null)
+            bridge.SendObserverState(lease.Connection, frame);
+        else
+        {
+            RetireObserver();
+            ScheduleAdvice();
+        }
+    }
+
+    private void RetireObserver()
+    {
+        if (_observerLease is not { } lease)
+            return;
+        _observerLease = null;
+        BridgeServer.Instance.SendObserverState(lease.Connection, lease.Withdraw());
+    }


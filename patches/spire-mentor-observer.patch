diff --git a/spire-mentor-mod/SpireMindLease.cs b/spire-mentor-mod/SpireMindLease.cs
new file mode 100644
--- /dev/null
+++ b/spire-mentor-mod/SpireMindLease.cs
@@ -0,0 +1,32 @@
+// Position-specific lease for SpireMind. This class has no game dependencies.
+using System.Text.Json;
+
+namespace SpireMentor;
+
+internal sealed class SpireMindLease(long connection, string requestId, long stateId,
+    long epoch, object? screen, string key)
+{
+    private long _sequence;
+    private bool _withdrawn;
+    public long Connection => connection;
+
+    public static bool OptedIn(JsonElement root) =>
+        root.TryGetProperty("capabilities", out JsonElement caps) && caps.ValueKind == JsonValueKind.Object &&
+        caps.TryGetProperty("spiremind_lease", out JsonElement lease) && lease.ValueKind == JsonValueKind.Number &&
+        lease.TryGetInt32(out int version) && version == 1;
+
+    public string? Confirm(long currentConnection, long currentEpoch, object? currentScreen, string? currentKey)
+    {
+        if (_withdrawn || connection <= 0 || connection != currentConnection || epoch != currentEpoch ||
+            !ReferenceEquals(screen, currentScreen) || key != currentKey)
+            return null;
+        return JsonSerializer.Serialize(new { type = "spiremind_confirm", request_id = requestId,
+            state_id = stateId, lease_seq = ++_sequence });
+    }
+
+    public string Withdraw()
+    {
+        _withdrawn = true;
+        return JsonSerializer.Serialize(new { type = "spiremind_withdraw", request_id = requestId, state_id = stateId });
+    }
+}
